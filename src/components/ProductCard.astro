---
interface Props {
  name: string;
  specs: string;
  description: string;
  price: string;
  image: string;
}

const { name, specs, description, price, image } = Astro.props;
---

<div class="flex w-full flex-col bg-background">
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={name}
      class="h-full w-full object-cover"
      loading="lazy"
    />
  </div>
  <div class="flex flex-col gap-3 py-6 max-md:py-5">
    <h3 class="font-heading text-2xl font-normal text-primary-light max-lg:text-xl max-md:text-lg">{name}</h3>
    <span class="font-body text-xs font-medium tracking-wide text-neutral">
      {specs}
    </span>
    <p class="font-body text-sm leading-[1.7] text-neutral max-md:text-[13px]">
      {description}
    </p>
    <span class="font-heading text-[22px] font-normal text-secondary max-lg:text-xl max-md:text-lg">
      {price}
    </span>
  </div>
</div>
