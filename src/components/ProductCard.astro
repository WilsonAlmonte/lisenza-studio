---
interface Props {
  name: string;
  specs: string;
  description: string;
  price: string;
  image: string;
  btnText: string;
}

const { name, specs, description, price, image, btnText } = Astro.props;
---

<div class="flex w-[360px] flex-col bg-background max-lg:w-full">
  <div class="h-[380px] overflow-hidden">
    <img
      src={image}
      alt={name}
      class="h-full w-full object-cover"
      loading="lazy"
    />
  </div>
  <div class="flex flex-col gap-4 px-0 py-6">
    <h3 class="font-heading text-2xl font-semibold text-primary-light">{name}</h3>
    <span class="font-body text-xs font-medium tracking-wide text-neutral">
      {specs}
    </span>
    <p class="font-body text-sm leading-[1.7] text-neutral">
      {description}
    </p>
    <div class="flex items-center justify-between">
      <span class="font-heading text-[22px] font-semibold text-secondary">
        {price}
      </span>
      <button class="bg-primary px-5 py-2.5 font-body text-xs font-semibold tracking-wide text-white transition-opacity hover:opacity-80">
        {btnText}
      </button>
    </div>
  </div>
</div>
