---
import { Icon } from "astro-icon/components";
import site from "../content/site.json";
---

<section class="relative h-[720px] w-full overflow-hidden max-lg:h-[600px] max-md:h-[560px]">
  <!-- Background image -->
  <img
    src={site.hero.bgImage}
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-bottom"
    loading="eager"
  />

  <!-- Dark gradient overlay -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, #1A1A1AE6, #1A1A1ACC 50%, #1A1A1A99);"
  ></div>

  <!-- Content -->
  <div class="relative flex h-full items-center px-[120px] max-lg:px-12 max-md:items-end max-md:px-6 max-md:pb-12">
    <div class="flex max-w-[650px] flex-col gap-7 max-lg:max-w-[500px] max-lg:gap-6 max-md:max-w-none max-md:gap-5">
      <h1 class="font-heading text-[80px] font-normal leading-[1.05] text-white max-lg:text-[56px] max-md:text-[36px] max-md:leading-[1.15]">
        {site.hero.headline}
      </h1>
      <p class="max-w-[520px] font-display text-[17px] leading-[1.7] text-white/80 max-lg:text-[16px] max-md:max-w-none max-md:text-[15px]">
        {site.hero.subheadline}
      </p>
      <a
        href="#productos"
        class="inline-flex w-fit items-center gap-2.5 bg-secondary px-10 py-4 font-body text-sm font-semibold tracking-wide text-white transition-opacity hover:opacity-90 max-md:w-full max-md:justify-center max-md:px-6 max-md:py-4 max-md:text-[13px]"
      >
        {site.hero.cta}
        <Icon name="lucide:arrow-right" class="size-4" />
      </a>
    </div>
  </div>
</section>
