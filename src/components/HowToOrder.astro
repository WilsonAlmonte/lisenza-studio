---
import { Icon } from "astro-icon/components";
import SectionHeader from "./SectionHeader.astro";
import howTo from "../content/how-to-order.json";
import site from "../content/site.json";
---

<section class="flex flex-col items-center gap-[60px] bg-dark px-20 py-[100px] max-lg:px-12 max-lg:py-16 max-md:gap-10 max-md:px-6 max-md:py-[60px]">
  <SectionHeader
    overline={howTo.overline}
    title={howTo.title}
    titleColor="text-white"
  />

  <!-- Steps -->
  <div class="flex w-full gap-8 px-10 max-lg:gap-6 max-lg:px-0 max-md:flex-col max-md:gap-5">
    {howTo.steps.map((step) => (
      <div class="flex flex-1 flex-col items-center gap-6 rounded-2xl border border-accent/[0.08] bg-primary px-9 py-10 max-lg:gap-5 max-lg:px-6 max-lg:py-8 max-md:gap-5 max-md:rounded-xl max-md:px-6 max-md:py-8">
        <div class="h-[3px] w-10 rounded-sm bg-accent"></div>
        <div class="flex size-[72px] items-center justify-center rounded-full bg-secondary/[0.13] max-md:size-[60px]">
          <Icon name={`lucide:${step.icon}`} class="size-8 text-accent max-md:size-6" />
        </div>
        <span class="font-heading text-sm font-normal tracking-[4px] text-accent max-md:text-xs max-md:tracking-[3px]">
          {step.number}
        </span>
        <h3 class="text-center font-heading text-xl font-normal text-white max-lg:text-lg max-md:text-lg">
          {step.title}
        </h3>
        <p class="text-center font-body text-sm leading-[1.7] text-white/60 max-md:text-[13px]">
          {step.description}
        </p>
      </div>
    ))}
  </div>

  <!-- WhatsApp CTA -->
  <a
    href={site.whatsapp.url}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center gap-3 rounded bg-whatsapp px-12 py-[18px] font-body text-[15px] font-semibold tracking-wide text-white transition-opacity hover:opacity-90 max-md:w-full max-md:rounded max-md:py-4 max-md:text-[14px]"
  >
    <Icon name="lucide:message-circle" class="size-5" />
    {site.whatsapp.cta}
  </a>
</section>
