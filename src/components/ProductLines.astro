---
import SectionHeader from "./SectionHeader.astro";
import ProductCard from "./ProductCard.astro";
import products from "../content/products.json";
---

<section id="productos" class="flex flex-col items-center gap-[60px] px-[120px] py-[100px] max-lg:px-12 max-md:px-6">
  <SectionHeader overline={products.overline} title={products.title} />
  <div class="flex w-full justify-center gap-10 max-lg:flex-col max-lg:items-center">
    {products.items.map((item) => (
      <ProductCard
        name={item.name}
        specs={item.specs}
        description={item.description}
        price={item.price}
        image={item.image}
        btnText={item.btnText}
      />
    ))}
  </div>
</section>
