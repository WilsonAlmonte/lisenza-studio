---
import SectionHeader from "./SectionHeader.astro";
import ProductCard from "./ProductCard.astro";
import products from "../content/products.json";
---

<section id="productos" class="flex flex-col items-center gap-[60px] px-[120px] py-[100px] max-lg:px-12 max-lg:py-16 max-md:gap-10 max-md:px-6 max-md:py-[60px]">
  <SectionHeader overline={products.overline} title={products.title} />
  <div class="grid w-full grid-cols-3 gap-10 max-lg:grid-cols-2 max-lg:gap-8 max-md:grid-cols-1 max-md:gap-8">
    {products.items.map((item) => (
      <ProductCard
        name={item.name}
        specs={item.specs}
        description={item.description}
        price={item.price}
        image={item.image}
      />
    ))}
  </div>
</section>
