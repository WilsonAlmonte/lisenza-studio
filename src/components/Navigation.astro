---
import { Icon } from "astro-icon/components";
import site from "../content/site.json";
---

<nav class="flex items-center justify-between bg-background px-20 py-5 max-lg:px-8 max-md:px-5 max-md:py-4">
  <!-- Left links (desktop only) -->
  <div class="flex items-center gap-8 max-lg:hidden">
    {site.nav.links.map((link) => (
      <a
        href={link.href}
        class="font-body text-[13px] font-medium tracking-wide text-primary-light transition-colors hover:text-secondary"
      >
        {link.label}
      </a>
    ))}
  </div>

  <!-- Hamburger (tablet + mobile) -->
  <button aria-label="Menú" class="hidden text-primary-light max-lg:block">
    <Icon name="lucide:menu" class="size-6" />
  </button>

  <!-- Center logo -->
  <div class="flex flex-col items-center gap-0.5">
    <span class="font-heading text-[28px] font-normal tracking-[6px] text-primary-light max-lg:text-[24px] max-md:text-[20px] max-md:tracking-[4px]">
      {site.nav.logo}
    </span>
    <span class="font-body text-[10px] font-medium tracking-[6px] text-neutral max-md:text-[8px] max-md:tracking-[3px]">
      {site.nav.logoSub}
    </span>
  </div>

  <!-- Right: lang + cart -->
  <div class="flex items-center gap-6">
    <span class="font-body text-xs font-medium tracking-wide text-neutral max-lg:hidden">
      {site.nav.langToggle}
    </span>
    <button aria-label="Carrito" class="text-primary-light">
      <Icon name="lucide:shopping-bag" class="size-5 max-md:size-[22px]" />
    </button>
  </div>
</nav>
<div class="h-px w-full bg-divider"></div>
