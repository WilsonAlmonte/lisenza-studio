---
import { Icon } from "astro-icon/components";
import site from "../content/site.json";
---

<footer class="flex flex-col gap-10 bg-primary px-[120px] py-[60px] max-lg:px-12 max-md:gap-8 max-md:px-6 max-md:py-12">
  <!-- Top row -->
  <div class="flex w-full justify-between max-md:flex-col max-md:items-center max-md:gap-10">
    <!-- Brand -->
    <div class="flex flex-col gap-3 max-md:items-center">
      <span class="font-heading text-[22px] font-normal tracking-[4px] text-white max-md:text-lg max-md:tracking-[3px]">
        {site.footer.logo}
      </span>
      <span class="font-display text-[13px] italic text-white/55 max-md:text-xs">
        {site.footer.tagline}
      </span>
    </div>

    <!-- Contact links -->
    <div class="flex flex-col items-end gap-4 max-md:items-center max-md:gap-4">
      <a href={`tel:${site.footer.phone.replace(/[() +\-]/g, "")}`} class="flex items-center gap-2.5 py-1">
        <Icon name="lucide:phone" class="size-4 text-accent" />
        <span class="font-body text-[13px] text-white/75">{site.footer.phone}</span>
      </a>
      <a href={`mailto:${site.footer.email}`} class="flex items-center gap-2.5 py-1">
        <Icon name="lucide:mail" class="size-4 text-accent" />
        <span class="font-body text-[13px] text-white/75">{site.footer.email}</span>
      </a>
      <a href="https://instagram.com/lisenza.studio" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 py-1">
        <Icon name="lucide:instagram" class="size-4 text-accent" />
        <span class="font-body text-[13px] text-white/75">{site.footer.instagram}</span>
      </a>
    </div>
  </div>

  <!-- Divider -->
  <div class="h-px w-full bg-white/[0.08]"></div>

  <!-- Copyright -->
  <p class="w-full text-center font-body text-[11px] text-white/35">
    {site.footer.copyright}
  </p>
</footer>
