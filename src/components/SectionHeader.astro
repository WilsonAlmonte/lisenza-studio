---
interface Props {
  overline: string;
  title: string;
  overlineColor?: string;
  titleColor?: string;
}

const {
  overline,
  title,
  overlineColor = "text-accent",
  titleColor = "text-primary-light",
} = Astro.props;
---

<div class="flex flex-col items-center gap-3">
  <span class:list={["font-body text-xs font-medium tracking-[4px]", overlineColor]}>
    {overline}
  </span>
  <h2 class:list={["text-center font-heading text-4xl font-semibold max-md:text-[28px]", titleColor]}>
    {title}
  </h2>
  <div class="h-px w-[60px] bg-accent"></div>
</div>
