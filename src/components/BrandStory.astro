---
import about from "../content/about.json";
---

<section id="historia" class="flex bg-background max-lg:flex-col">
  <!-- Owner photo -->
  <div class="h-[563px] w-[580px] flex-shrink-0 overflow-hidden max-lg:h-[400px] max-lg:w-full">
    <img
      src={about.image}
      alt={about.author}
      class="h-full w-full object-cover"
      loading="lazy"
    />
  </div>

  <!-- Content -->
  <div class="flex flex-1 flex-col justify-center gap-7 p-20 max-lg:p-12 max-md:p-6">
    <span class="font-body text-xs font-medium tracking-[4px] text-accent">
      {about.overline}
    </span>
    <h2 class="font-heading text-4xl font-semibold text-primary-light max-md:text-[28px]">
      {about.title}
    </h2>
    {about.paragraphs.map((p) => (
      <p class="font-body text-[15px] leading-[1.8] text-neutral">{p}</p>
    ))}
    <div class="h-px w-10 bg-accent"></div>
    <div class="flex flex-col gap-1">
      <span class="font-display text-base italic text-secondary">
        {about.author}
      </span>
      <span class="font-body text-xs font-medium tracking-wide text-neutral">
        {about.role}
      </span>
    </div>
  </div>
</section>
