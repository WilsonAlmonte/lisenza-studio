---
import { Icon } from "astro-icon/components";
import SectionHeader from "./SectionHeader.astro";
import gtk from "../content/good-to-know.json";
---

<section class="flex flex-col items-center gap-[60px] bg-background-warm px-[120px] py-[100px] max-lg:px-12 max-lg:py-16 max-md:gap-10 max-md:px-6 max-md:py-[60px]">
  <SectionHeader overline={gtk.overline} title={gtk.title} />

  <div class="grid w-full grid-cols-4 gap-8 max-lg:grid-cols-2 max-lg:gap-6 max-md:grid-cols-1 max-md:gap-4">
    {gtk.items.map((item) => (
      <div class="flex flex-col gap-4 rounded-sm border border-divider bg-background px-7 py-8 max-lg:px-6 max-lg:py-7 max-md:gap-3 max-md:px-5 max-md:py-6">
        <Icon name={`lucide:${item.icon}`} class="size-7 text-secondary max-md:size-6" />
        <h3 class="font-heading text-lg font-normal text-primary-light max-md:text-base">
          {item.title}
        </h3>
        <p class="font-body text-sm leading-[1.7] text-neutral max-md:text-[13px]">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</section>
